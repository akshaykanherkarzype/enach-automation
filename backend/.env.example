# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# MySQL, Redis, RabbitMQ
# docker-compose publishes MySQL 3307, Redis 6380, RabbitMQ 5673.
# -----------------------------------------------------------------------------
DATABASE_URL=mysql://batch:batch@127.0.0.1:3307/upi_batch
REDIS_URL=redis://127.0.0.1:6380
RABBITMQ_URL=amqp://batch:batch@127.0.0.1:5673

INVOICE_GENERATION_QUEUE=invoice-generation-queue
INVOICE_CHARGE_QUEUE=invoice-charge-queue
INVOICE_GENERATION_DLQ=invoice-generation-dlq
INVOICE_CHARGE_DLQ=invoice-charge-dlq

# -----------------------------------------------------------------------------
# How fast a batch runs
#
# Order of the limits (the slowest one wins):
#   1. QUEUE_CONSUMERS     listeners per queue. Both queues share one connection.
#                          2 does not multiply QUEUE_CONCURRENCY.
#   2. QUEUE_CONCURRENCY   customers this worker may hold at once (RabbitMQ prefetch).
#                          Keep this a little above PAYMENT_MAX_IN_FLIGHT.
#   3. PAYMENT_MAX_IN_FLIGHT
#                          how many of those customers may be waiting on
#                          payment-service at the same time. Used only when
#                          PAYMENT_CLIENT=http.
#   4. PAYMENT_REQUEST_GAP_MS
#                          minimum pause between the start of one payment call
#                          and the next. 125 = at most 8 new calls per second.
#
# Calls per second = the smaller of:
#   1000 / PAYMENT_REQUEST_GAP_MS
#   PAYMENT_MAX_IN_FLIGHT / seconds the gateway call takes
#
# Same load data-pipeline already sends to prod payment-service: 8 calls at
# once, and a 125ms pause before each Respo call. Their prefetch of 1000 is
# how many messages one job pulls, not how many HTTP calls run, so
# QUEUE_CONCURRENCY stays just above the in-flight cap.
# PAYMENT_ADAPTIVE still lowers this ceiling if our own calls slow down.
# Restart the worker after changing any of these.
# -----------------------------------------------------------------------------
QUEUE_CONSUMERS=2
QUEUE_CONCURRENCY=12
# Ceiling, not a fixed rate. When UPI response time rises, the worker
# cuts in-flight calls and widens the gap, then restores them as it recovers.
# PAYMENT_ADAPTIVE=false keeps these two numbers fixed.
PAYMENT_MAX_IN_FLIGHT=8
PAYMENT_REQUEST_GAP_MS=125
PAYMENT_ADAPTIVE=true

# Host pressure from the PM2 dashboard (respo-prod) plus payment-service /metrics.
# Slow at memory 80% / disk 85% / CPU 75% / event loop 250ms.
# Pause at memory 90% / disk 92% / CPU 90% / event loop 1s. A pause does not use MAX_RETRY.
# HOST_PRESSURE=false keeps the normal pace. A monitoring outage does not stop the batch.
HOST_PRESSURE=true
GRAFANA_PROMETHEUS_URL=https://monitoring.respo.co.in/api/datasources/proxy/uid/ef4nzsqdakgsge
HOST_METRICS_INSTANCE=respo-prod

# How long one HTTP call may run before it is treated as a timeout (retryable).
API_TIMEOUT=120000
# How long a worker waits for a free payment permit before requeueing.
# That wait does not use up MAX_RETRY.
PAYMENT_SLOT_WAIT_MS=600000

# Retries when payment-service sets retryable=true, or the call throws / returns 5xx.
# INVOICE_NOT_READY_FOR_CHARGE is deferred and does not use these delays.
# Delays are attempt 1, 2, 3.
MAX_RETRY=3
RETRY_DELAYS_MS=5000,30000,120000

# Rows inserted into MySQL per statement. This does not change payment speed.
BATCH_SIZE=500

# -----------------------------------------------------------------------------
# Uploaded files (MinIO locally, S3 in production)
# -----------------------------------------------------------------------------
UPLOAD_MAX_SIZE=20MB
S3_BUCKET=batch-files
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# Dashboard login
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Dev users. Password for all three is "password".
DEV_USER_VIEW=viewer@zype.local
DEV_USER_UPLOAD=uploader@zype.local
DEV_USER_ADMIN=admin@zype.local

# -----------------------------------------------------------------------------
# Payment-service
# mock = local stub (ignores in-flight, gap, and peak hours).
# http  = synchronous UPI routes, one customer object per request:
#         POST /payment-service/api/v2/upi/autopay/invoice
#         POST /payment-service/api/v2/upi/autopay/charge
# A 200 body { "status": "success", "retryable": false } is success.
# Failures follow the body's retryable flag. Thrown calls and 5xx still retry.
# PAYMENT_SERVICE_BASE_URL is required when PAYMENT_CLIENT=http. Origin only.
# X_API_KEY is the same value payment-service expects in the x-api-key header
# on /upi/autopay/invoice and /upi/autopay/charge. Health check does not use it.
# -----------------------------------------------------------------------------
PAYMENT_CLIENT=mock
PAYMENT_SERVICE_BASE_URL=http://localhost:3000
X_API_KEY=

# Unused by the UPI routes. Left so an existing environment file still loads.
PAYMENT_CALL_BUDGET_MS=2500

# Do not call payment-service in these IST windows. "none" disables the skip.
# Default blocks 10:00-13:00 and 17:00-22:00. Each window must end the same day.
PEAK_WINDOWS_IST=10:00-13:00,17:00-22:00

# Invoice generation is sent only on the batch's IST day. A queue message that
# arrives the next day is failed and is not sent. Charge may continue next day.
# The last INVOICE_DAY_END_BUFFER_MS before midnight is also refused.
INVOICE_SAME_DAY_GUARD=true
INVOICE_DAY_END_BUFFER_MS=300000

# Used only when PAYMENT_CLIENT=mock.
MOCK_PAYMENT_SUCCESS_RATE=0.9
MOCK_PAYMENT_LATENCY_MS=200

# -----------------------------------------------------------------------------
# Email when a batch finishes
# Sent to the uploader and BATCH_REPORT_EMAIL. The HTML shows a few sample failures. failed.csv is attached with every failed customer.
# Transport, first match wins:
#   1. SMTP when SMTP_HOST, EMAIL_ADDRESS, and EMAIL_PASSWORD are all set
#      (same shape as loan-service; port 465 is implicit TLS)
#   2. SES when both AWS_ACCESS_KEY_ID_SES and AWS_SECRET_ACCESS_KEY_SES are set
#   3. Log only, when EMAIL_ENABLED=false or neither transport is configured
# -----------------------------------------------------------------------------
EMAIL_ENABLED=true
EMAIL_FROM=noreply@getzype.com
FROM_EMAIL_ADDRESS=noreply@getzype.com
BATCH_REPORT_EMAIL=akshay.kanherkar@getzype.com

SMTP_HOST=
SMTP_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID_SES=
AWS_SECRET_ACCESS_KEY_SES=
